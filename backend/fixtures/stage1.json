  "policies": [
    {"source_id": "KB01", "title": "Return policy", "version": 1, "effective_date": "2026-01-01", "approval_status": "approved", "region": "US", "product": "board_games", "topic": "return", "rule_key": "unused_received_30", "excerpt": "Unused orders qualify for a return through calendar day 30 after delivery, inclusive. A refund requires a recorded receipt of the return. Day 31 is outside the window. Escalate used items for review."},
    {"source_id": "KB02", "title": "Damage policy", "version": 1, "effective_date": "2026-01-01", "approval_status": "approved", "region": "US", "product": "board_games", "topic": "damage", "rule_key": "damage_declaration_14", "excerpt": "Within 14 days after delivery, a damaged line with a completed damage declaration can receive a replacement or a refund up to its net paid amount. Apply one remedy per eligible amount or unit."},
    {"source_id": "KB03", "title": "Delay policy", "version": 1, "effective_date": "2026-01-01", "approval_status": "approved", "region": "US", "product": "board_games", "topic": "delay", "rule_key": "shipment_checked_7", "excerpt": "At least seven calendar days after the promised date, draft a status update using verified facts. Check the original shipment before proposing a replacement. An unknown status gives no new delivery date. A shipment change invalidates a conflicting proposal."},
    {"source_id": "KB04", "title": "Refund accounting", "version": 1, "effective_date": "2026-01-01", "approval_status": "approved", "region": "US", "product": "board_games", "topic": "accounting", "rule_key": "settled_less_refunds", "excerpt": "At both order and line level, subtract verified prior refunds and pending reservations from the settled paid amount. Pending and uncertain operations reserve their amounts. A refund requires eligibility, settlement and reviewer approval."},
    {"source_id": "KB05", "title": "Evidence applicability", "version": 1, "effective_date": "2026-01-01", "approval_status": "approved", "region": "US", "product": "board_games", "topic": "evidence", "rule_key": "current_approved_evidence", "excerpt": "Use current approved policies that match the product and region. Missing or conflicting evidence requires escalation. A confidence estimate cannot override an eligibility check."},
    {"source_id": "KB71", "title": "Collector edition return guidance", "version": 1, "effective_date": "2026-05-01", "approval_status": "approved", "region": "US", "product": "collector_edition", "topic": "return", "rule_key": "unused_received_30", "excerpt": "An unused collector edition qualifies for return through calendar day 30 after delivery, inclusive. A refund requires a recorded receipt of the return."},
    {"source_id": "KB72", "title": "Collector edition refund exclusion", "version": 1, "effective_date": "2026-05-01", "approval_status": "approved", "region": "US", "product": "collector_edition", "topic": "return", "rule_key": "no_collector_returns", "excerpt": "Collector editions are excluded from the return program. A refund is unavailable even when an unused unit was returned within 30 days."},
    {"source_id": "KB73", "title": "Archived edition return policy", "version": 1, "effective_date": "2026-01-01", "expires_on": "2026-11-01", "approval_status": "approved", "region": "US", "product": "archived_edition", "topic": "return", "rule_key": "unused_received_30", "excerpt": "Unused archived editions qualify for return through calendar day 30 after delivery, inclusive. A refund requires a recorded receipt of the return."}
